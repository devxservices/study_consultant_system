# Copy to deploy/.env on the server and fill in every line marked REQUIRED.
# Generate each secret with:   openssl rand -hex 32
# Never change JWT_SECRET, MFA_ENCRYPTION_KEY or STORAGE_ENCRYPTION_KEY after
# launch: sessions, two-step sign-in and stored files depend on them.

# --- Your platform ----------------------------------------------------------
# REQUIRED. The domain you bought for the platform. Consultancies get
# <name>.yourcrm.com, you sign in at admin.yourcrm.com.
PLATFORM_DOMAIN=yourcrm.com
# REQUIRED. The same domain with https://
WEB_ORIGIN=https://yourcrm.com
# REQUIRED. The server's public IP address. Consultancies using a root domain
# (theirname.com rather than portal.theirname.com) point an A record here.
PUBLIC_IP=203.0.113.10
# REQUIRED. Let's Encrypt writes here about certificates (expiry problems).
ACME_EMAIL=you@yourcrm.com
# The time zone dates and "today" are shown in (IANA name). The servers would
# otherwise use UTC, five hours behind Pakistan.
TZ=Asia/Karachi
# Optional. If you run your own consultancy on the platform, its address
# name here makes it open at the bare yourcrm.com as well.
# DEFAULT_TENANT_SLUG=

# --- Secrets (REQUIRED, each: openssl rand -hex 32) --------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY=

# --- Email (REQUIRED for password resets and invitations) --------------------
# Any SMTP service works: Brevo, Mailgun, SendGrid, Amazon SES, Zoho, Google
# Workspace. Emails go out under each consultancy's own name, from this address.
MAIL_DRIVER=smtp
MAIL_FROM=YourCRM <no-reply@yourcrm.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Files ------------------------------------------------------------------
# Default: on the server's disk (the "files" volume), encrypted, included in
# deploy/backup.sh. To use S3, Cloudflare R2 or Backblaze B2 instead:
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional ---------------------------------------------------------------
# Virus scanning of uploads (start the clamav service: see docker-compose.yml)
# VIRUS_SCAN=clamav
# CLAMAV_HOST=clamav
# SMS and WhatsApp reminders through Twilio
# MESSAGING_DRIVER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
