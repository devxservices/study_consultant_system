# Copy to .env and adjust. Every value below has a working local default,
# so the app runs with no .env file at all.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset for local development: the API runs an embedded
# Postgres (PGlite) from ./.data/pg, so there is nothing to install.
#
# Set it to move to a real Postgres. Nothing else in the code changes - the
# same migrations and schema apply to both.
# DATABASE_URL=postgresql://user:password@host:5432/consultancy
# DB_SSL=true
# DB_POOL_MAX=10
# How long a request waits for a free pooled connection before failing (ms).
# DB_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# MUST be set to a long random value in production. The app refuses to boot in
# production while this is still the development default.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d
COOKIE_NAME=crm_session
# Leave COOKIE_DOMAIN unset. Each consultancy's session cookie must stay on its
# own address; a shared parent domain would send one consultancy's session to
# every other consultancy's subdomain (the API refuses it there, but it should
# never be sent in the first place).
# COOKIE_DOMAIN=
# Encrypts two-step verification secrets at rest (AES-256-GCM). 32 bytes as 64
# hex characters or base64 - generate with: openssl rand -hex 32
# Required in production. In development it is derived from JWT_SECRET.
# Never change it once people have enrolled: their authenticator apps would stop
# working and each of them would need a reset.
# MFA_ENCRYPTION_KEY=
# The header your edge proxy (nginx, Caddy, load balancer) sets to the real
# client address, overwriting anything the browser sent - e.g. x-real-ip. The
# audit trail records it, and the sign-in rate limit uses it per address.
# Leave unset when nothing in front sets it: a header a browser can forge is
# worse than none.
# CLIENT_IP_HEADER=x-real-ip
# A ceiling per signed-in account: a burst of RATE_LIMIT_BURST requests, then
# RATE_LIMIT_PER_MINUTE. Far above any person's pace; it exists for scripts and
# runaway clients. Per API instance. 0 switches it off (off by default in tests).
# RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_BURST=120

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# Every consultancy is served at <slug>.PLATFORM_DOMAIN and at any custom
# domain it has verified. The platform admin signs in at ADMIN_HOST.
# Browsers resolve *.localhost to this machine, so locally there is no DNS to
# set up: http://futurepath.localhost:3000, http://admin.localhost:3000.
PLATFORM_DOMAIN=localhost
# ADMIN_HOST=admin.localhost
# The consultancy served at the bare PLATFORM_DOMAIN (http://localhost:3000).
# Defaults to "main" outside production. Leave unset in production.
# DEFAULT_TENANT_SLUG=main

# ---------------------------------------------------------------------------
# Servers
# ---------------------------------------------------------------------------
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Used by the Next.js server to reach the API (proxy + server components).
# The browser never talks to the API directly - including the realtime
# sockets, which go through the same /api proxy on the page's own origin.
API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# File storage (used from the document upload step onwards)
# ---------------------------------------------------------------------------
# 'local' writes to ./storage. Switch to 's3' for AWS S3, Cloudflare R2 or
# Backblaze B2 - all three speak the same API.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage
# S3_BUCKET=consultancy-documents
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Seed data
# ---------------------------------------------------------------------------
SEED_PASSWORD=password123
