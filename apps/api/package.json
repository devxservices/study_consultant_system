{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "db:push": "npm run db:generate && npm run db:migrate",
    "db:reset": "tsx src/db/scripts/reset.ts",
    "admin:create": "tsx src/db/scripts/create-admin.ts",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/test/rate-limit.test.js .test-build/test/tenant-isolation.test.js .test-build/test/security.test.js .test-build/test/foundations.test.js .test-build/test/drive.test.js .test-build/test/workflows.test.js .test-build/test/finance.test.js .test-build/test/commissions.test.js .test-build/test/partners.test.js .test-build/test/courses.test.js .test-build/test/student-process.test.js .test-build/test/accounts.test.js .test-build/test/subscription.test.js",
    "bench": "tsc -p tsconfig.test.json && node .test-build/test/perf.bench.js",
    "db:seed:extras": "tsx src/db/scripts/seed-extras.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@crm/shared": "*",
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
